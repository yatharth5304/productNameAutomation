# =============================================================================
# .gitignore — Product Name Automation
# =============================================================================

# ── Python bytecode & cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Excel temporary / lock files (created while workbook is open) ─────────────
~$*.xlsx
~$*.xls
~$*.csv

# ── Fine-tuned / local ML model artifacts ────────────────────────────────────
# Full model directories are large (hundreds of MB) and should not be committed.
# Use model-sharing services (HuggingFace Hub, DVC, etc.) for model versioning.
models/

# ── Generated embedding matrices ─────────────────────────────────────────────
# Ignore the .npy binary blobs but keep embedding metadata files
# (e.g. master_embeddings_meta.json, master_record_index.json,
#  finetuned_master_meta.csv) so they remain trackable.
embeddings/*.npy

# ── Backup files ─────────────────────────────────────────────────────────────
*.bak

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Claude Code session data ──────────────────────────────────────────────────
# .claude/ contains credentials, session tokens, daemon state, and local
# per-machine backups. None of this should be committed.
# NOTE: this directory is already tracked; to stop tracking it run:
#   git rm -r --cached .claude/
.claude/


# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ── Python virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE / editor metadata ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Large raw data files (do not commit) ──────────────────────────────────────
testraw.xlsx
testingg.xlsx

# ── Generated intermediate datasets (do not commit) ───────────────────────────
v2_*.csv
v2_*.xlsx
hard_negative_mining.csv
hard_negative_validation.csv
hard_negative_quality_analysis.csv
finetuned_evaluation_results.csv
baseline_evaluation_results.csv
training_split.csv
profile_results.txt

# ── Generated reports (auto-generated, do not commit) ─────────────────────────
*_REPORT.md
*_ANALYSIS_REPORT.md
PROFILING_REPORT.md
V2_VALIDATION_REPORT.md
V2_HARD_NEGATIVE_QUALITY_REPORT.md
V2_CONSTRUCTION_REPORT.md
GARBAGE_REVIEW_ANALYSIS.md
STAGE2_ANALYSIS_REPORT.md

# ── Large generated output files ──────────────────────────────────────────────
outputtest.txt
garbage_review_analysis.csv
review_reclassification.csv
MAPPING_MAIN_OUTPUT.xlsx
PRODUCT_MASTER1.xlsx

# ── Temporary Python scripts (analysis/debug, not production) ────────────────
construct_v2*.py
fix_eval_leakage.py
validate_v2.py
validate_final_v2.py
reconstruct_v2*.py
profile_*.py
stage2_part*.py
final_v2_report.py
